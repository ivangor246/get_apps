OLLAMA_URL=http://localhost:11434
OLLAMA_LLM_MODEL=gemma4:e2b
OLLAMA_TIMEOUT=120

# ONNX embedding model from fastembed (see TextEmbedding.list_supported_models())
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# cuda or cpu
EMBEDDING_DEVICE=cuda
EMBEDDING_DIM=1024
# GPU forward-pass batch size; reduce if OOM (e.g. 2 for 4 GB VRAM)
EMBEDDING_BATCH_SIZE=8
# Hard VRAM cap for onnxruntime CUDA arena, in MB
EMBEDDING_GPU_MEM_LIMIT_MB=3072

RAG_TOP_K=20
RAG_CANDIDATE_K=500

API_HOST=127.0.0.1
API_PORT=8000
